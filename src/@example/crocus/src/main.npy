import "src/@example/crocus/src/print_ascii.npy";

func is_no_number(str: [char]) -> int {
    for (i: int = 0; str[i] != '\0'; i++) {
        if (str[i] > '9' || str[i] < '0') {
            ret 0;
        }
    }
    ret 1;
}

func main(data_n: [char], data_s: [char]) {
    print_ascii(data_n, data_s);
}

main("0123456789\0", "noupy\0");
