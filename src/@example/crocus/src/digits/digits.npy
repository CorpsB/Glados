import "src/@example/crocus/src/digits/display_line.npy";

func zero(line: int, c: char) {
    if (line == 0) {
        display_line("oxxxo\0", c);
    }
    if (line == 1) {
        display_line("xooox\0", c);
    }
    if (line == 2) {
        display_line("xooox\0", c);
    }
    if (line == 3) {
        display_line("xooox\0", c);
    }
    if (line == 4) {
        display_line("oxxxo\0", c);
    }
}

