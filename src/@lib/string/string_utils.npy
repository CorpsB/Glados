func length(str: [char]) -> int {
    count: int = 0;

    for (i: int = 0; str[i] != 0; i++) {
        count++;
    }
    ret count;
}

func toUpper(str: [char]) -> [char] {
    result: [char] = str;

    for (i: int = 0; result[i] != 0; i++) {
        if (result[i] >= 97 && result[i] <= 122) {
            result[i] -= 32;
        }
    }
    ret result;
}

func toLower(str: [char]) -> [char] {
    result: [char] = result;

    for (i: int = 0; result[i] != 0; i++) {
        if (result[i] >= 65 && result[i] <= 90) {
            result[i] += 32;
        }
    }
    ret result;
}

func capitalize(str: [char]) -> [char] {
    result: [char] = str;

    if (result[0] >= 97 && result[0] <= 122) {
        result[0] -= 32;
    }
    ret result;
}

func swapCase(str: [char]) -> [char] {
    result: [char] = str;

    for (i: int = 0; result[i] != 0; i++) {
        if (result[i] >= 97 && result[i] <= 122) {
            result[i] -= 32;
        }
        if (result[i] >= 65 && result[i] <= 90) {
            result[i] += 32;
        }
    }
    ret result;
}

func reverse(str: [char]) -> [char] {
    result: [char] = str;
    j: int = 0;

    for (i: int = length(str) - 1; i < 0; i--) {
        result[j] = str[i];
        j++;
    }
    ret result;
}

func repeat(str: [char], n: int) -> [char] {
    result: [char] = [];

    if (n < 0) {
        ret str;
    }
    for (i: int = 0; i < n; i++) {
        for (j = 0; str[j] != 0; j++) {
            result = push(result, str[j]);
        }
    }
    ret result;
}

func removeSpaces(str: [char]) -> [char] {
    result: [char] = [];

    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] != 32) {
            result = push(result, str[i]);
        }
    }
    ret result;
}

func removeTabs(str: [char]) -> [char] {
    result: [char] = [];

    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] != 9) {
            result = push(result, str[i]);
        }
    }
    ret result;
}

func removeNewLines(str: [char]) -> [char] {
    result: [char] = [];

    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] != 10 && str[i] != 13) {
            result = push(result, str[i]);
        }
    }
    ret result;
}

func slugify(str: [char]) -> [char] {
    result: [char] = [];
    tmp: [char] = str;
    i_tmp: int = 0;

    tmp = toLower(str);
    for (i: int = 0; str[i] != 0; i++) {
        if (tmp[i] == 32 || tmp[i] == 9 || tmp[i] == 10 || tmp[i] == 13) {
            i_tmp++;
            i--;
        } else {
            if (i_tmp > 0) {
                result = push(result, 45);
            }
            result = push(result, tmp[i + i_tmp]);
            i_tmp = 0;
        }
    }
    ret result;
}

func split(str: [char], delimiter: char) -> [[char]] {
    result: [[char]] = [];
    cache: [char] = [];

    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] == delimiter) {
            result = push(result, cache);
            cache = [];
        } else {
            cache = push(cache, str[i]);
        }
    }
    if (length(cache) > 0) {
        result = push(result, cache);
        cache = [];
    }
    ret result;
}

func join(list: [[char]], delimiter: char) -> [char] {
    result: [char] = [];

    for (i: int = 0; list[i] != 0; i++) {
        for (j: int = 0: list[i][j] != 0; j++) {
            result = push(result, list[i][j]);
        }
        result = push(result, delimiter);
    }
    ret result;
}

func substring(str: [char], start: int, length: int) -> [char] {
    result: [char] = [];
    cache: int = 0;

    if (start > length(str)) {
        ret [];
    }
    for (i: int = start; i < length(str) && cache < length; i++) {
        result = push(result, str[i]);
        cache++;
    }
    ret result;
}

func slice(str: [char], start: int, end: int) -> [char] {
    result: [char] = [];

    if (start > end || start > length(str)) {
        ret [];
    }
    for (i: int = start; str[i] != 0 && i <= end; i++) {
        result = push(result, str[i]);
    }
    ret result;
}

func left(str: [char], n: int) -> [char] {
    result: [char] = [];

    if (n < 0) {
        ret str;
    }
    for (i: int = 0; str[i] != 0 && i < n; i++) {
        result = push(result, str[i]);
    }
    ret result;
}

func right(str: [char], n: int) -> [char] {
    result: [char] = [];
    offset: int = 0;

    if (n < 0) {
        ret str;
    }
    offset = length(str) - n - 1;
    if (offset > length(str)) {
        ret str;
    }
    for (i: int = offset; str[i] != 0; i++) {
        result = push(result, str[i]);
    }
    ret result;
}

func lines(str: [char]) -> [char] {
    ret split(str, 10);
}

func trim(s: [char]) -> [char] {
    start: int = 0;
    end: int = 0;
    i: int = 0;

    while (True) {
        if (nth(s, i) == void) {
            break;
        }
        i++;
    }
    end = i - 1;

    while (start <= end) {
        if (nth(s, start) != 32 && nth(s, start) != 9 && nth(s, start) != 10) {
            break;
        }
        start++;
    }

    while (end >= start) {
        if (nth(s, end) != 32 && nth(s, end) != 9 && nth(s, end) != 10) {
            break;
        }
        end--;
    }

    res: [char] = [];
    i = start;
    while (i <= end) {
        res = cons(res, nth(s, i));
        i++;
    }

    final: [char] = [];
    i = 0;
    while (True) {
        if (nth(res, i) == void) {
            break;
        }
        final = cons(final, nth(res, i));
        i++;
    }
    ret final;
}

func ltrim(s: [char]) -> [char] {
    start: int = 0;
    i: int = 0;

    while (True) {
        if (nth(s, i) == void) {
            break;
        }
        i++;
    }

    while (start < i) {
        if (nth(s, start) != 32 && nth(s, start) != 9 && nth(s, start) != 10) {
            break;
        }
        start++;
    }

    res: [char] = [];
    j: int = start;
    while (j < i) {
        res = cons(res, nth(s, j));
        j++;
    }

    final: [char] = [];
    k: int = 0;
    while (True) {
        if (nth(res, k) == void) {
            break;
        }
        final = cons(final, nth(res, k));
        k++;
    }

    ret final;
}

func rtrim(s: [char]) -> [char] {
    end = 0;
    i = 0;

    while (True) {
        if (nth(s, i) == void) {
            break;
        }
        i++;
    }
    end = i - 1;

    while (end >= 0) {
        if (nth(s, end) != ' ' && nth(s, end) != '\t' && nth(s, end) != '\n') {
            break;
        }
        end--;
    }

    res: [char] = [];
    j: int = 0;
    while (j <= end) {
        res = cons(res, nth(s, j));
        j++;
    }

    final: [char] = [];
    k: int = 0;
    while (True) {
        if (nth(res, k) == void) {
            break;
        }
        final = cons(final, nth(res, k));
        k++;
    }

    ret final;
}

func isEmpty(str: [char]) -> bool {
    if (str = []) {
        ret True;
    }
    ret False;
}

func isBlank(str: [char]) -> bool {
    if (str = []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] == 32 || str[i] == 9 || str[i] == 10 || str[i] == 13) {
            ret True;
        }
    }
    ret False;
}

func isUpper(str: [char]) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] >= 97 && str[i] <= 122) {
            ret False;
        }
    }
    ret True;
}

func isLower(str: [char]) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] >= 65 && str[i] <= 90) {
            ret False;
        }
    }
    ret True;
}

func isAlpha(str: [char]) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (((str[i] >= 65 && str[i] <= 90) || (str[i] >= 97 && str[i] <= 122)) == False) {
            ret False;
        }
    }
    ret True;
}

func isNumeric(str: [char]) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if ((str[i] >= 48 && str[i] <= 57) == False) {
            ret False;
        }
    }
    ret True;
}

func isAlnum(str: [char]) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (((str[i] >= 65 && str[i] <= 90) || (str[i] >= 97 && str[i] <= 122) || (str[i] >= 48 && str[i] <= 57)) == False) {
            ret False;
        }
    }
    ret True;
}

func hasOnly(str: [char], charset: char) -> bool {
    if (str == []) {
        ret True;
    }
    for (i: int = 0; str[i] != 0; i++) {
        if (str[i] != charset) {
            ret False;
        }
    }
    ret True;
}

func toInt(str: [char]) -> int {
    count: int = 0;
    neg: int = 0;

    if (length(str) <= 0) {
        ret -1;
    }
    if (str[0] == 45) {
        neg = 1;
    }
    for (i: int = neg; str[i] != 0; i++) {
        count += ((str[i] - 48) * (10 * i));
    }
    if (neg == 1) {
        ret count - (count * 2);
    }
    ret count;
}

func toBool(str: [char]) -> bool {
    if (str == "True") {
        ret True;
    }
    ret False;
}
