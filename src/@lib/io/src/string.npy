func split_lines(content: [char]) -> [[char]] {
    lines: [[char]] = [['\0']];
    current_line: [char] = ['\0'];
    len: int = length(content); // Supposons une fonction length()

    i: int = 0;
    while (i < len) {
        c: char = nth(content, i);
        if (c == '\n') {
            lines = cons(current_line, lines);
            current_line = ['\0'];
        } else {
            current_line = cons(c, current_line); 
        }
        i = i + 1;
    }
    if (length(current_line) > 0) {
        lines = cons(current_line, lines);
    }
    ret lines;
}
