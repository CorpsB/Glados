func intSqrt(n: int) -> int {
    if (n <= 0) { ret 0; }
    if (n == 1) { ret 1; }

    lo: int = 1;
    hi: int = n;
    ans: int = 0;

    while (lo <= hi) {
        mid: int = (lo + hi) / 2;

        if (mid <= (n / mid)) {
            ans = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    ret ans;
}

func isPerfectSquare(n: int) -> bool {
    if (n < 0) { ret False; }
    r: int = intSqrt(n);
    ret (r * r) == n;
}
