func isPrime(n: int) -> bool {
    if (n <= 1) { ret False; }
    if (n == 2) { ret True; }
    if ((n % 2) == 0) { ret False; }

    i: int = 3;
    while (i <= (n / i)) {
        if ((n % i) == 0) { ret False; }
        i = i + 2;
    }
    ret True;
}

func nextPrime(n: int) -> int {
    if (n <= 2) { ret 2; }
    p: int = n;
    if ((p % 2) == 0) { p = p + 1; }

    while (!isPrime(p)) {
        p = p + 2;
    }
    ret p;
}
