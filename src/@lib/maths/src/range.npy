func sumRange(a: int, b: int) -> int {
    if (a > b) { ret 0; }
    s: int = 0;
    i: int = a;
    while (i <= b) {
        s = s + i;
        i = i + 1;
    }
    ret s;
}

func productRange(a: int, b: int) -> int {
    if (a > b) { ret 1; }
    p: int = 1;
    i: int = a;
    while (i <= b) {
        p = p * i;
        i = i + 1;
    }
    ret p;
}
