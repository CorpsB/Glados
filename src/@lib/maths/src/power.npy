func pow(base: int, exp: int) -> int {
    if (exp < 0) { ret 0; }
    if (exp == 0) { ret 1; }

    b: int = base;
    e: int = exp;
    res: int = 1;

    while (e > 0) {
        if ((e % 2) == 1) { res = res * b; }
        b = b * b;
        e = e / 2;
    }
    ret res;
}

func pow10(n: int) -> int {
    if (n < 0) { ret 0; }
    ret pow(10, n);
}

func modPow(base: int, exp: int, m: int) -> int {
    if (m <= 0) { ret 0; }
    if (exp < 0) { ret 0; }

    b: int = modPos(base, m);
    e: int = exp;
    res: int = 1;

    while (e > 0) {
        if ((e % 2) == 1) { res = (res * b) % m; }
        b = (b * b) % m;
        e = e / 2;
    }
    ret res;
}
