func phi(n: int) -> int {
    if (n <= 0) { ret 0; }
    x: int = n;
    res: int = n;

    p: int = 2;
    while (p <= (x / p)) {
        if ((x % p) == 0) {
            res = res - (res / p);
            while ((x % p) == 0) {
                x = x / p;
            }
        }
        if (p == 2) { p = 3; } else { p = p + 2; }
    }

    if (x > 1) {
        res = res - (res / x);
    }
    ret res;
}

func modInv(a: int, m: int) -> int {
    if (m <= 1) { ret 0; }

    t: int = 0;
    newt: int = 1;
    r: int = m;
    newr: int = modPos(a, m);

    while (!(newr == 0)) {
        q: int = r / newr;

        tmp: int = t;
        t = newt;
        newt = tmp - (q * newt);

        tmp2: int = r;
        r = newr;
        newr = tmp2 - (q * newr);
    }

    if (!(r == 1)) { ret 0; }

    if (t < 0) { t = t + m; }
    ret t;
}
