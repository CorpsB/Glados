func factorial(n: int) -> int {
    if (n < 0) { ret 0; }
    acc: int = 1;
    i: int = 2;
    while (i <= n) {
        acc = acc * i;
        i = i + 1;
    }
    ret acc;
}

func perm(n: int, k: int) -> int {
    if (k < 0) { ret 0; }
    if (k > n) { ret 0; }

    acc: int = 1;
    i: int = 0;
    while (i < k) {
        acc = acc * (n - i);
        i = i + 1;
    }
    ret acc;
}

func binom(n: int, k: int) -> int {
    if (k < 0) { ret 0; }
    if (k > n) { ret 0; }

    kk: int = k;
    if (kk > (n - kk)) { kk = n - kk; }

    res: int = 1;
    i: int = 1;
    while (i <= kk) {
        num: int = (n - kk) + i;
        den: int = i;

        g1: int = gcd(num, den);
        num = num / g1;
        den = den / g1;

        g2: int = gcd(res, den);
        res = res / g2;
        den = den / g2;

        res = res * num;
        if (!(den == 1)) {
            res = res / den;
        }

        i = i + 1;
    }
    ret res;
}
