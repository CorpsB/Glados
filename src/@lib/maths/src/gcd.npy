func gcd(a: int, b: int) -> int {
    x: int = a;
    y: int = b;

    if (x < 0) { x = 0 - x; }
    if (y < 0) { y = 0 - y; }

    while (!(y == 0)) {
        t: int = x % y;
        x = y;
        y = t;
    }
    ret x;
}

func lcm(a: int, b: int) -> int {
    if (a == 0 || b == 0) { ret 0; }
    g: int = gcd(a, b);
    x: int = a / g;
    v: int = x * b;
    if (v < 0) { ret 0 - v; }
    ret v;
}

func coprime(a: int, b: int) -> bool {
    ret gcd(a, b) == 1;
}
