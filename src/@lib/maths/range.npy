func sumrange(from: int, to: int) -> int {
    if (from > to) { ret 0; }
    s: int = 0;
    i: int = from;
    while (i <= to) {
        s = s + i;
        i = i + 1;
    }
    ret s;
}

func prodrange(from: int, to: int) -> int {
    if (from > to) { ret 1; }
    p: int = 1;
    i: int = from;
    while (i <= to) {
        p = p * i;
        i = i + 1;
    }
    ret p;
}
