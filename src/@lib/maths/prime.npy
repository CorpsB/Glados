func isprime(n: int) -> bool {
    if (n <= 1) { ret False; }
    if (n <= 3) { ret True; }
    if ((n % 2) == 0) { ret False; }

    lim: int = isqrt(n);
    d: int = 3;
    while (d <= lim) {
        if ((n % d) == 0) { ret False; }
        d = d + 2;
    }
    ret True;
}

func nextprime(n: int) -> int {
    if (n <= 2) { ret 2; }
    x: int = n;
    if ((x % 2) == 0) { x = x + 1; }

    while (True) {
        if (isprime(x)) { ret x; }
        x = x + 2;
    }
    ret 0;
}
