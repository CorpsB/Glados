
// ------------------------------------------------------------
// CAS 1 : Variable Inconnue
// Code : x + 1; (Adapté en assignation pour le check)
// Attendu : Undefined variable 'x'
// ------------------------------------------------------------

/**Test de commentaire*/



res: int = x;


// ------------------------------------------------------------
// CAS 2 : Type Mismatch
// Code : var a: int = "hello"; (Adapté en bool car pas de string)
// Attendu : Variable 'a' declared as int but assigned bool
// ------------------------------------------------------------

// a: int = True;


// ------------------------------------------------------------
// CAS 3 : If Incohérent
// Code : if (true) { 1 } else { "no" }
// Note : Le parser impose des blocs {}. On teste via une variable pour forcer le checkExpr.
// Attendu : Type mismatch in 'if' branches (int vs bool)
// ------------------------------------------------------------

// res_if: int = if (True) { 1 } else { False };


// ------------------------------------------------------------
// CAS 4 : Struct Incomplète
// Code : struct P {x:int}; var p:P = P{};
// Attendu : Missing field 'x' in construction of 'P'
// ------------------------------------------------------------

// struct P { x: int; }
//p: P = new P {};


// ------------------------------------------------------------
// CAS 5 : Struct Invalide (Mauvais type de champ)
// Code : struct P {x:int}; var p:P = P{x:true};
// Attendu : Field 'x' expected int but got bool
// ------------------------------------------------------------

// struct P { x: int; }
// p: P = new P { x: True };


// ------------------------------------------------------------
// CAS 6 : Code Valide
// Code : struct P {x:int}; var p:P = P{x:1};
// Attendu : (Pas d'erreur, affichage de l'AST)
// ------------------------------------------------------------

struct P { x: int; }
p: P = new P { x: 1 };