// === 9. Boucle While ===
func count_to_ten(start: int) {
    i: int = start;
    
    while (i < 10) {
        print(i);
        i = i + 1;
    }
}


// === 10. Boucles For (Nouveaux Tests) ===
func test_loops() {
    // Boucle standard
    for (i = 0; i < 5; i = i + 1) {
        print(i);
    }

    // Boucle avec multiplication dans l'update
    for (n = 1; n < 100; n = n * 2) {
        print(n);
    }
}

func test_logic(x: int) -> int {
    // Test du NOT
    if (!is_valid) {
    }
    
    // Test combinaison
    if (!(x == 0) && x < 10) {
        ret 1;
    }
}

func test_unary(val: int) -> int {
    // Incrémentation simple (équivalent à val = val + 1)
    ++val;
    
    // Décrémentation
    --val;
    
    // Dans une boucle while
    i: int = 0;
    while (i < 5) {
        print(i);
        ++i; // Plus propre que i = i + 1
    }

    ret val;
}


func test_compound(base: int) -> int {
    x: int = base;
    
    x += 10;
    x -= 5;
    x *= 2;
    x /= 2;
    
    ret x;
}

func test_arrays() {
    arr: [int] = [10, 20, 30];
    
    val = arr[1]; // Doit valoir 20
    print(val);
    
    res = arr[0] + arr[2]; // 10 + 30 = 40
    print(res);
    
    matrix = [[1, 2], [3, 4]];
    elem = matrix[1][0];
    print(elem);
}

