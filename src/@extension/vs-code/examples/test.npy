// === 5. Fonctions ===
// Fonction simple
func add(a: int, b: int) -> int {
    ret a + b;
}

// Fonction sans retour explicite (void implicite)
func log(msg: [char]) {
    print(msg);
}

// Fonction sans arguments
func get_pi() -> int {
    ret 3;
}

// === 6. Appels de fonctions et Expressions ===
res = add(10, 20);
val = (10 + 2) * 5;

// === 7. Cas d'erreurs potentielles (pour vérifier le parsing, pas l'éval) ===
// Le parser doit accepter ça, c'est l'évaluateur qui crashera plus tard
overflow: int8 = 14000;
bad_list = [1, True, "mix"];


// === 8. Instruction conditionnelle & Logique (&& / ||) ===
func test_logic(x: int) -> int {
    // Test du ET logique
    if (x > 0 && x < 100) {
        ret 1;
    } 
    // Test du OU logique
    else if (x == 0 || x == 100) {
        ret 2;
    } 
    // Ordre de priorité (&& avant ||) : a || (b && c)
    else if (x == 1 || x == 2 && x == 3) { 
        ret 3;
    } 
    else {
        ret 0;
    }
}


