

// 1. Déclarations de base
a: int = 10;
b: int = 20;
flag: bool = True;

// 2. Opérateurs Arithmétiques
// Attendu : int
res_add: int = a + b;
res_sub: int = b - a;
res_mul: int = a * 2;
res_div: int = b / 2;
res_mod: int = b % 3; 

// 3. Opérateurs de Comparaison
// Attendu : bool
is_less: bool = a < b;
is_more: bool = b > a;
is_leq: bool  = a <= 10;
is_geq: bool  = b >= 20;

// 4. Égalité
// Attendu : bool
is_eq_int: bool = (a == 10);
is_eq_bool: bool = (flag == True);

// 5. Logique
// Attendu : bool
logic_and: bool = flag && True;
logic_or: bool  = False || flag;
logic_not: bool = !False;

// 6. Fonction Utilisateur
// Définition d'une fonction simple
func add(x: int, y: int) -> int {
    ret x + y;
}

// Appel valide
sum: int = add(5, 15);

// Appel imbriqué
sum_nested: int = add(a, add(1, 1));